# Copy this file to `.env.local` and fill in the values from your Firebase
# project settings (Project settings -> General -> Your apps -> SDK setup).
# `.env.local` is already in .gitignore, so your keys never get committed.
#
# Note: Firebase's client-side "API key" is not a secret in the way a
# server API key is -- it just identifies your project. Real protection
# comes from the Firestore Security Rules (see firestore.rules) and from
# restricting the key to your domains in the Google Cloud Console.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
